rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Affected data model (checkout/cash repair)
    // ===============================================================
    // sales/{saleId}: immutable completed sale; numeric createdAt + branchId are required for
    // new cashier writes. Legacy owner restores remain readable/updateable.
    // cashRegisters/{branchId}: bounded current-shift state only. A legacy transactions list
    // may remain, but every update must leave it untouched.
    // cashRegisters/{branchId}/transactions/{transactionId}: append-only, creator-bound ledger.
    // checkoutEvents/{eventId}: append-only attempt/outcome audit event.

    // Global Safety Net default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Fortress Rules
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Path helper functions
    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function memberPath(companyId, memberId) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(memberId);
    }

    function branchPath(companyId, branchId) {
      return /databases/$(database)/documents/companies/$(companyId)/branches/$(branchId);
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitationCodes/$(code);
    }

    // Membership verification helper functions
    function getMemberData(companyId) {
      return get(memberPath(companyId, request.auth.uid)).data;
    }
    
    function getMemberRole(companyId) {
      return getMemberData(companyId).role;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && getMemberData(companyId).role in ['owner', 'admin', 'employee'];
    }
    
    function isOwner(companyId) {
      return isSignedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && getMemberData(companyId).role == 'owner'
        && get(companyPath(companyId)).data.ownerId == request.auth.uid;
    }

    // Credential employees use managed @logicpos.com identities that cannot verify an inbox.
    // They may write only after the Owner has already provisioned their member document.
    function canWriteCompany(companyId) {
      return isVerifiedUser() || (
        isSignedIn() && request.auth.token.email is string
        && request.auth.token.email.matches('.*@logicpos\\.com')
        && isMemberOfCompany(companyId)
      );
    }

    function allowedPermissions() {
      return ['sales_history', 'products_edit', 'stock_transfer', 'stock_restock',
        'suppliers_restock', 'cash_close', 'apply_discount'];
    }

    // Stored permissions add to defaults; admin is never a permission bypass.
    function hasPermission(companyId, perm) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      return perm in allowedPermissions() && (
        (member.role == 'owner' && get(companyPath(companyId)).data.ownerId == request.auth.uid)
        || (member.role == 'admin' && perm in ['stock_transfer', 'stock_restock'])
        || ('permissions' in member && member.permissions is list && perm in member.permissions)
      );
    }

    function validBranch(companyId, branchId) {
      return isValidId(branchId) && exists(branchPath(companyId, branchId));
    }

    function assignedBranch(companyId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      return 'assignedBranchId' in member ? member.assignedBranchId : '';
    }

    function canUseBranch(companyId, branchId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      return (member.role == 'owner' && get(companyPath(companyId)).data.ownerId == request.auth.uid) || (
        member.role in ['admin', 'employee']
        && ('assignedBranchId' in member && member.assignedBranchId == branchId)
        && validBranch(companyId, branchId)
      );
    }

    function isMatrix(companyId, branchId) {
      return validBranch(companyId, branchId)
        && ('isMatriz' in get(branchPath(companyId, branchId)).data && get(branchPath(companyId, branchId)).data.isMatriz == true);
    }

    function canTransferBetween(companyId, branchId, counterpartId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      let userBranch = ('assignedBranchId' in member) ? member.assignedBranchId : '';
      return branchId != counterpartId && validBranch(companyId, branchId)
        && validBranch(companyId, counterpartId) && (
          (member.role == 'owner' && get(companyPath(companyId)).data.ownerId == request.auth.uid)
          || (
            member.role in ['admin', 'employee'] && (
              (userBranch == branchId && isMatrix(companyId, counterpartId))
              || (userBranch == counterpartId && isMatrix(companyId, branchId))
            )
          )
        );
    }

    function canReadMovement(companyId, data) {
      return canUseBranch(companyId, data.branchId)
        || (data.type in ['transfer_in', 'transfer_out']
          && canTransferBetween(companyId, data.branchId, data.counterpartBranchId));
    }

    // Map diff restricts ordinary checkout/restock writes to the assigned key.
    // Product documents have no movement/sale ID: getAfter cannot discover the randomly
    // named audit writes. The two-key transfer exception therefore remains uncorrelated
    // and cannot prove its second key is Matrix. See FIRESTORE_RULES_AUDIT.json.
    function canUpdateStock(companyId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      let branch = ('assignedBranchId' in member) ? member.assignedBranchId : '';
      let before = ('branchStocks' in existing()) ? existing().branchStocks : {};
      let after = ('branchStocks' in incoming()) ? incoming().branchStocks : {};
      let changed = after.diff(before).affectedKeys();
      let perms = ('permissions' in member && member.permissions is list) ? member.permissions : [];
      let canRestock = member.role == 'owner' || (member.role == 'admin') || ('stock_restock' in perms) || ('products_edit' in perms);
      let canTransfer = member.role == 'owner' || (member.role == 'admin') || ('stock_transfer' in perms);
      return (member.role == 'owner' && get(companyPath(companyId)).data.ownerId == request.auth.uid) || (
        member.role in ['admin', 'employee']
        && validBranch(companyId, branch)
        && (branch in after) && after[branch] is number && after[branch] >= 0
        && after[branch] <= 1000000
        && (
          (changed.hasOnly([branch])
            && ((branch in before && after[branch] <= before[branch]) || canRestock))
          || (canTransfer
            && changed.size() == 2 && changed.hasAny([branch])
            && incoming().stock == existing().stock)
        )
      );
    }

    // A restock legitimately records the purchase cost and supplier next to the stock
    // increase (the client writes costPrice + supplierId in the same update). Allow those two
    // catalogue fields only when the write is a genuine restock of the actor's own branch:
    // stock_restock capability, exactly that map key changed, and its value went up. Any other
    // catalogue field, or a cost/supplier change without a stock increase, still needs
    // products_edit. canUpdateStock() is still evaluated on top of this by the update rule.
    function isRestockCatalogueUpdate(companyId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      let branch = ('assignedBranchId' in member) ? member.assignedBranchId : '';
      let before = ('branchStocks' in existing()) ? existing().branchStocks : {};
      let after = ('branchStocks' in incoming()) ? incoming().branchStocks : {};
      return hasPermission(companyId, 'stock_restock')
        && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'branchStocks', 'costPrice', 'supplierId'])
        && incoming().diff(existing()).affectedKeys().hasAny(['branchStocks'])
        && after.diff(before).affectedKeys().hasOnly([branch])
        && (branch in after) && after[branch] is number
        && ((branch in before && before[branch] is number) ? after[branch] > before[branch] : after[branch] > 0)
        && incoming().costPrice is number && incoming().costPrice >= 0
        && incoming().supplierId is string;
    }

    // Refunding a sale flips its status to Refunded. The owner may do that for any sale (and
    // also runs global invoicing); an admin (Encargado) may refund a Completed sale that
    // belongs to their own assigned branch, and nothing else about the sale. The stock, cash
    // and customer-balance writes that accompany a refund already pass the branch-scoped rules
    // for products, cash registers and customers, so they need no extra exception here.
    function canAdminRefundSale(companyId) {
      return getMemberData(companyId).role == 'admin'
        && ('branchId' in existing())
        && canUseBranch(companyId, existing().branchId)
        && existing().status == 'Completed'
        && incoming().status == 'Refunded'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    function canCreateProductStock(companyId) {
      let member = get(memberPath(companyId, request.auth.uid)).data;
      let branch = ('assignedBranchId' in member) ? member.assignedBranchId : '';
      return (member.role == 'owner' && get(companyPath(companyId)).data.ownerId == request.auth.uid) || (
        member.role in ['admin', 'employee']
        && validBranch(companyId, branch)
        && (!('branchStocks' in incoming()) || incoming().branchStocks.keys().hasOnly([branch]))
      );
    }

    // Validation shape rules
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
          && data.email is string && data.email.size() <= 200
          && (!('name' in data) || (data.name is string && data.name.size() <= 200))
          && (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp))
          && (!('companies' in data) || (data.companies is map))
          && (!('activeCompanyId' in data) || (data.activeCompanyId is string || data.activeCompanyId == null));
    }

    function isValidCompany(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && data.ownerId is string && data.ownerId.size() <= 128
          && (!('invitationCode' in data) || (data.invitationCode is string && data.invitationCode.size() <= 100) || data.invitationCode == null)
          && (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    function isValidCompanyMember(companyId, data) {
      return data.userId is string && data.userId.size() <= 128
          && data.name is string && data.name.size() <= 200
          && data.email is string && data.email.size() <= 200
          && data.role in ['owner', 'admin', 'employee']
          && (!('joinedAt' in data) || (data.joinedAt is string || data.joinedAt is timestamp))
          && (!('assignedBranchId' in data) || (data.assignedBranchId is string && data.assignedBranchId.size() <= 128))
          && (data.role == 'owner' || ('assignedBranchId' in data && validBranch(companyId, data.assignedBranchId)))
          && (!('customRoleName' in data) || (data.customRoleName is string && data.customRoleName.size() <= 100))
          && (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() <= 100))
          && (!('isCredentialAccount' in data) || data.isCredentialAccount is bool)
          && (!('permissions' in data) || (
            data.permissions is list && data.permissions.size() <= 7
            && data.permissions.hasOnly(allowedPermissions())
          ));
    }

    function isValidInvitationCode(data) {
      return data.keys().hasOnly([
            'code', 'companyId', 'companyName', 'role', 'usageType',
            'createdAt', 'expiresAt', 'createdBy', 'assignedBranchId'
          ])
          && data.code is string && data.code.size() <= 100
          && data.companyId is string && data.companyId.size() <= 128
          && data.companyName is string && data.companyName.size() <= 200
          && data.role in ['employee', 'admin']
          && validBranch(data.companyId, data.assignedBranchId)
          && data.usageType is string && (data.usageType == 'single' || data.usageType == 'multiple')
          && data.createdAt is timestamp
          && data.expiresAt is timestamp && data.expiresAt > request.time
          && data.expiresAt < request.time + duration.value(8, 'd')
          && data.createdBy is string && data.createdBy == request.auth.uid;
    }

    function isUsableInvitation(companyId, role, code) {
      return role in ['admin', 'employee'] && code is string
          && exists(invitationPath(code))
          && get(invitationPath(code)).data.code == code
          && get(invitationPath(code)).data.companyId == companyId
          && get(invitationPath(code)).data.role == role
          && incoming().assignedBranchId == get(invitationPath(code)).data.assignedBranchId
          && (!('permissions' in incoming()) || incoming().permissions.size() == 0)
          && (!('isCredentialAccount' in incoming()) || incoming().isCredentialAccount == false)
          && get(invitationPath(code)).data.expiresAt is timestamp
          && get(invitationPath(code)).data.expiresAt > request.time
          && get(companyPath(companyId)).data.invitationCode == code
          && (
            get(invitationPath(code)).data.usageType == 'multiple'
            || (
              get(invitationPath(code)).data.usageType == 'single'
              && !existsAfter(invitationPath(code))
              && getAfter(companyPath(companyId)).data.invitationCode == null
            )
          );
    }

    function isConsumingSingleUseInvitation(companyId) {
      return existing().invitationCode is string
          && incoming().invitationCode == null
          && incoming().diff(existing()).affectedKeys().hasOnly(['invitationCode'])
          && exists(invitationPath(existing().invitationCode))
          && get(invitationPath(existing().invitationCode)).data.companyId == companyId
          && get(invitationPath(existing().invitationCode)).data.usageType == 'single'
          && get(invitationPath(existing().invitationCode)).data.expiresAt > request.time
          && !existsAfter(invitationPath(existing().invitationCode))
          && existsAfter(memberPath(companyId, request.auth.uid))
          && getAfter(memberPath(companyId, request.auth.uid)).data.inviteCode == existing().invitationCode;
    }

    function isTransferringOwnership(companyId) {
      return isVerifiedUser()
          && isOwner(companyId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId != existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId'])
          && exists(memberPath(companyId, incoming().ownerId))
          && (!('isCredentialAccount' in get(memberPath(companyId, incoming().ownerId)).data)
            || get(memberPath(companyId, incoming().ownerId)).data.isCredentialAccount == false)
          && getAfter(memberPath(companyId, incoming().ownerId)).data.userId == incoming().ownerId
          && getAfter(memberPath(companyId, incoming().ownerId)).data.role == 'owner'
          && getAfter(memberPath(companyId, existing().ownerId)).data.userId == existing().ownerId
          && get(memberPath(companyId, incoming().ownerId)).data.role in ['admin', 'employee']
          && getAfter(memberPath(companyId, existing().ownerId)).data.role == 'admin'
          && validBranch(companyId, getAfter(memberPath(companyId, existing().ownerId)).data.assignedBranchId);
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && data.category is string && data.category.size() <= 100
          && data.costPrice is number && data.costPrice >= 0.0
          && data.salePrice is number && data.salePrice >= 0.0
          && data.stock is number && data.stock >= 0 && data.stock <= 1000000
          && data.minStock is int && data.minStock >= 0
          && (!('branchStocks' in data) || data.branchStocks is map)
          && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
          && (!('sku' in data) || (data.sku is string && data.sku.size() <= 100))
          && (!('supplierId' in data) || (data.supplierId is string && data.supplierId.size() <= 128))
          && (!('linkedStockProductId' in data) || (data.linkedStockProductId is string && data.linkedStockProductId.size() <= 128))
          && (!('stockConsumptionFactor' in data) || (data.stockConsumptionFactor is number && data.stockConsumptionFactor > 0.0 && data.stockConsumptionFactor <= 1000.0))
          && (!('isStockPool' in data) || data.isStockPool is bool);
    }

    function isValidCustomer(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
          && (!('email' in data) || (data.email is string && data.email.size() <= 200))
          && (!('unpaidBalance' in data) || (data.unpaidBalance is number && data.unpaidBalance >= 0 && data.unpaidBalance <= 1000000000))
          && (!('registeredDate' in data) || (data.registeredDate is string && data.registeredDate.size() <= 100));
    }

    function isValidBranch(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && (!('address' in data) || (data.address is string && data.address.size() <= 500))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
          && (!('manager' in data) || (data.manager is string && data.manager.size() <= 200));
    }

    function isValidSupplier(data) {
      return data.id is string && data.id.size() <= 128
          && data.name is string && data.name.size() <= 200
          && (!('contactName' in data) || (data.contactName is string && data.contactName.size() <= 200))
          && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
          && (!('email' in data) || (data.email is string && data.email.size() <= 200))
          && (!('address' in data) || (data.address is string && data.address.size() <= 500))
          && (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    // Schema Validation Helpers
    function isValidSale(data) {
      return data.id is string && data.id.size() <= 128
          && data.items is list && data.items.size() <= 450
          && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0.0))
          && (!('discount' in data) || (data.discount is number && data.discount >= 0.0))
          && (!('tax' in data) || (data.tax is number && data.tax >= 0.0))
          && data.total is number && data.total >= 0.0
          && data.paymentMethod is string && (data.paymentMethod == 'Cash' || data.paymentMethod == 'Card' || data.paymentMethod == 'Debit' || data.paymentMethod == 'Transfer' || data.paymentMethod == 'Credit')
          && (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128))
          && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 200))
          && data.timestamp is string && data.timestamp.size() <= 100
          && data.status is string && (data.status == 'Completed' || data.status == 'Refunded')
          && (!('createdAt' in data) || data.createdAt is number)
          && (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 128))
          && (!('folio' in data) || (data.folio is string && data.folio.size() <= 200))
          && (!('requiresInvoice' in data) || data.requiresInvoice is bool)
          && (!('invoiceStatus' in data) || (data.invoiceStatus is string && (data.invoiceStatus == 'pending' || data.invoiceStatus == 'completed')))
          && (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 200));
    }

    function isValidNewSale(data) {
      return isValidSale(data)
          && data.items.size() > 0
          && data.subtotal is number && data.subtotal >= 0
          && data.discount is number && data.discount >= 0 && data.discount <= data.subtotal
          && data.tax is number && data.tax >= 0
          && data.total == data.subtotal - data.discount + data.tax
          && data.createdAt is number
          && data.branchId is string && data.branchId.size() > 0 && data.branchId.size() <= 128
          && data.status == 'Completed';
    }

    function isValidCashRegister(data) {
      return data.isOpen is bool
          && data.initialCash is number && data.initialCash >= 0.0
          && data.currentCash is number
          && (!('transactions' in data) || data.transactions is list)
          && (!('lastOperationalDate' in data) || (data.lastOperationalDate is string && data.lastOperationalDate.size() <= 20))
          && (!('currentShiftId' in data) || (data.currentShiftId is string && data.currentShiftId.size() <= 128))
          && (!('openedAt' in data) || data.openedAt is number)
          && (!('closedAt' in data) || data.closedAt is number)
          && (!('lastTransactionId' in data) || (data.lastTransactionId is string && isValidId(data.lastTransactionId)))
          && (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidCashTransaction(data, registerId, transactionId) {
      return data.keys().hasOnly([
            'id', 'type', 'amount', 'cashDelta', 'description', 'time', 'timestamp',
            'createdAt', 'branchId', 'shiftId', 'saleId', 'paymentMethod', 'createdBy',
            'balanceAfter'
          ])
          && data.id is string && data.id == transactionId && isValidId(data.id)
          && data.type is string && (
            data.type == 'Ingreso' || data.type == 'Egreso' || data.type == 'Venta' ||
            data.type == 'Transferencia' || data.type == 'Apertura' || data.type == 'Cierre'
          )
          && data.amount is number && data.amount >= 0.0 && data.amount <= 1000000000
          && data.cashDelta is number && data.cashDelta >= -1000000000 && data.cashDelta <= 1000000000
          && data.description is string && data.description.size() <= 1000
          && data.time is string && data.time.size() <= 100
          && data.timestamp is string && data.timestamp.size() <= 100
          && data.createdAt is number
          && data.branchId is string && data.branchId == registerId
          && data.createdBy is string && data.createdBy == request.auth.uid
          && (!('shiftId' in data) || (data.shiftId is string && data.shiftId.size() <= 128))
          && (!('saleId' in data) || (data.saleId is string && data.saleId.size() <= 128))
          && (!('paymentMethod' in data) || (data.paymentMethod is string && (
            data.paymentMethod == 'Cash' || data.paymentMethod == 'Card' ||
            data.paymentMethod == 'Transfer' || data.paymentMethod == 'Credit'
          )))
          && (
            data.type != 'Venta'
            || (
              data.paymentMethod == 'Cash' && data.cashDelta == data.amount
            )
            || (
              data.paymentMethod != 'Cash' && data.cashDelta == 0
            )
          )
          && data.balanceAfter is number;
    }

    function cashLedgerPath(companyId, registerId, transactionId) {
      return /databases/$(database)/documents/companies/$(companyId)/cashRegisters/$(registerId)/transactions/$(transactionId);
    }

    function hasMatchingCashLedger(companyId, registerId) {
      return incoming().lastTransactionId is string
          && existsAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId))
          && getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.branchId == registerId
          && getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.createdBy == request.auth.uid;
    }

    function isValidCashRegisterCreate(companyId, registerId) {
      return isValidCashRegister(incoming())
          && !('transactions' in incoming())
          && incoming().isOpen == true
          && hasMatchingCashLedger(companyId, registerId)
          && getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.type == 'Apertura'
          && incoming().currentCash == getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.amount;
    }

    function isValidCashRegisterUpdate(companyId, registerId) {
      return isValidCashRegister(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'isOpen', 'initialCash', 'currentCash', 'lastOperationalDate', 'currentShiftId',
            'openedAt', 'closedAt', 'lastTransactionId', 'updatedAt'
          ])
          && hasMatchingCashLedger(companyId, registerId)
          && (
            (
              getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.type == 'Apertura'
              && incoming().isOpen == true
              && incoming().currentCash == incoming().initialCash
              && incoming().currentCash == getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.amount
            )
            ||
            (
              getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.type == 'Cierre'
              && existing().isOpen == true && incoming().isOpen == false
              && incoming().currentCash == getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.balanceAfter
            )
            ||
            (
              incoming().isOpen == existing().isOpen
              && incoming().currentCash == existing().currentCash + getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.cashDelta
              && (
                incoming().initialCash == existing().initialCash
                || isOwner(companyId)
              )
            )
          );
    }

    function isValidStockMovement(data) {
      return data.id is string && data.id.size() <= 128
          && data.type is string && (data.type == 'surtido' || data.type == 'merma' || data.type == 'transfer_in' || data.type == 'transfer_out')
          && data.productId is string && data.productId.size() <= 128
          && data.productName is string && data.productName.size() <= 200
          && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
          && data.branchId is string && data.branchId.size() <= 128
          && (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 200))
          && (!('counterpartBranchId' in data) || (data.counterpartBranchId is string && data.counterpartBranchId.size() <= 128))
          && (!('counterpartBranchName' in data) || (data.counterpartBranchName is string && data.counterpartBranchName.size() <= 200))
          && (!('userName' in data) || (data.userName is string && data.userName.size() <= 200))
          && data.timestamp is string && data.timestamp.size() <= 100
          && data.createdAt is number
          && (!('transferId' in data) || (data.transferId is string && data.transferId.size() <= 128))
          && (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0 && data.unitPrice <= 1000000000));
    }

    function isValidCheckoutEvent(data) {
      return data.keys().hasOnly([
            'id', 'saleId', 'status', 'timestamp', 'createdAt', 'branchId', 'branchName',
            'employeeName', 'userId', 'paymentMethod', 'total', 'itemCount', 'errorMessage',
            'isSessionInvalid'
          ])
          && data.id is string && data.id.size() <= 128
          && data.saleId is string && data.saleId.size() <= 128
          && data.status is string && (
               data.status == 'started' || data.status == 'success' || data.status == 'failed' ||
               data.status == 'offline_queued' || data.status == 'offline_resolved_success' ||
               data.status == 'offline_resolved_failed'
             )
          && data.timestamp is string && data.timestamp.size() <= 100
          && (!('createdAt' in data) || data.createdAt is number)
          && (!('branchId' in data) || (data.branchId is string && data.branchId.size() <= 128))
          && (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 200))
          && (!('employeeName' in data) || (data.employeeName is string && data.employeeName.size() <= 200))
          && data.userId is string && data.userId == request.auth.uid
          && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 20))
          && (!('total' in data) || data.total is number)
          && (!('itemCount' in data) || data.itemCount is number)
          && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 1000))
          && (!('isSessionInvalid' in data) || data.isSessionInvalid is bool);
    }

    // User Profile Document Access Rules
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isVerifiedUser() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isVerifiedUser() && isValidUser(incoming()) && (
        request.auth.uid == userId
        ||
        // An Owner cleaning up a departing member's cross-reference right after deleting
        // companies/{companyId}/members/{userId}: that member doc is the source of truth for
        // access, but users/{userId} also caches a `companies` map for fast lookups, and only
        // the user themselves could normally touch their own doc — leaving it stale forever
        // otherwise. Scoped tight: only fires when the target belonged to exactly the one
        // company being revoked (true for the credential employees this is meant for; a user
        // in multiple companies needs the extra ones cleared by hand), the actor genuinely
        // owns that company, and the write only touches companies/activeCompanyId.
        (
          'companies' in existing() && existing().companies.keys().size() == 1 &&
          isOwner(existing().companies.keys()[0]) &&
          incoming().companies.size() == 0 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['companies', 'activeCompanyId'])
        )
      );
      allow delete: if isVerifiedUser() && request.auth.uid == userId;

      // Legacy collections (Backwards compatibility)
      match /products/{productId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, create, update, delete: if isSignedIn() && request.auth.uid == userId && isValidId(productId) && 
          (request.method == 'get' || request.method == 'delete' || (isVerifiedUser() && isValidProduct(incoming()) && incoming().id == productId));
      }

      match /customers/{customerId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, create, update, delete: if isSignedIn() && request.auth.uid == userId && isValidId(customerId) &&
          (request.method == 'get' || request.method == 'delete' || (isVerifiedUser() && isValidCustomer(incoming()) && incoming().id == customerId));
      }

      match /branches/{branchId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, create, update, delete: if isSignedIn() && request.auth.uid == userId && isValidId(branchId) &&
          (request.method == 'get' || request.method == 'delete' || (isVerifiedUser() && isValidBranch(incoming()) && incoming().id == branchId));
      }

      match /suppliers/{supplierId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, create, update, delete: if isSignedIn() && request.auth.uid == userId && isValidId(supplierId) &&
          (request.method == 'get' || request.method == 'delete' || (isVerifiedUser() && isValidSupplier(incoming()) && incoming().id == supplierId));
      }

      match /sales/{saleId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, create, delete: if isSignedIn() && request.auth.uid == userId && isValidId(saleId) &&
          (request.method == 'get' || request.method == 'delete' || (isVerifiedUser() && isValidSale(incoming()) && incoming().id == saleId));
        allow update: if isVerifiedUser() && request.auth.uid == userId && isValidId(saleId) && isValidSale(incoming()) && incoming().id == saleId
          && (incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      }

      match /cashRegisters/{registerId} {
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow get, delete: if isSignedIn() && request.auth.uid == userId && isValidId(registerId);
        allow create: if isVerifiedUser() && request.auth.uid == userId && isValidId(registerId)
          && isValidCashRegister(incoming())
          && (!('transactions' in incoming()) || incoming().transactions.size() <= 2000);
        allow update: if isVerifiedUser() && request.auth.uid == userId && isValidId(registerId)
          && isValidCashRegister(incoming())
          && (!('transactions' in incoming()) || incoming().transactions == existing().transactions);
      }
    }

    // Companies Collection Root
    match /companies/{companyId} {
      allow get: if isSignedIn() && isMemberOfCompany(companyId);
      allow list: if isSignedIn() && isMemberOfCompany(companyId);
      allow create: if isVerifiedUser() && isValidCompany(incoming()) && incoming().id == companyId && incoming().ownerId == request.auth.uid;
      allow update: if isValidCompany(incoming()) && incoming().id == companyId && (
        (incoming().ownerId == existing().ownerId && (
          (isVerifiedUser() && isOwner(companyId))
          || (isVerifiedUser() && isConsumingSingleUseInvitation(companyId))
        ))
        || isTransferringOwnership(companyId)
      );
      allow delete: if isVerifiedUser() && isOwner(companyId);

      // Members Subcollection inside Company
      match /members/{memberId} {
        allow get: if isSignedIn() && isMemberOfCompany(companyId)
          && (request.auth.uid == memberId || isOwner(companyId));
        allow list: if isSignedIn() && isOwner(companyId);

        // A member document may only be created through one of three legitimate paths:
        //   A) Founder self-claiming 'owner' right after creating their own company doc
        //   B) Self-join backed by a real invitation code matching this company + role
        //   C) The owner directly provisioning a new member (e.g. credential employees) —
        //      Only the real Owner manages
        //      the team roster (branch reassignment, role grants, new accounts, removal).
        allow create: if isVerifiedUser() && isValidCompanyMember(companyId, incoming()) && incoming().userId == memberId && (
          (request.auth.uid == memberId && incoming().role == 'owner' &&
            exists(/databases/$(database)/documents/companies/$(companyId)) &&
            get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid)
          ||
          (request.auth.uid == memberId && 'inviteCode' in incoming()
            && isUsableInvitation(companyId, incoming().role, incoming().inviteCode))
          ||
          (request.auth.uid != memberId && isOwner(companyId) && incoming().role in ['admin', 'employee'])
        );

        // Updating a member (branch reassignment, role change, permissions) — owner-only.
        allow update: if isVerifiedUser() && isValidCompanyMember(companyId, incoming()) &&
          incoming().userId == memberId && existing().userId == memberId && isOwner(companyId)
          && get(companyPath(companyId)).data.ownerId == request.auth.uid && (
            (existing().role != 'owner' && incoming().role != 'owner')
            || (existing().role == 'owner' && incoming().role == 'owner')
            || (existing().role != 'owner' && incoming().role == 'owner'
              && getAfter(companyPath(companyId)).data.ownerId == memberId)
            || (existing().role == 'owner' && incoming().role == 'admin'
              && memberId == request.auth.uid
              && getAfter(companyPath(companyId)).data.ownerId != memberId)
          );

        // Deleting/removing a member — owner-only.
        allow delete: if isVerifiedUser() && isOwner(companyId) && existing().role != 'owner';
      }

      // Products subcollection inside Company
      match /products/{productId} {
        allow list, get: if isSignedIn() && isMemberOfCompany(companyId);
        allow create, delete: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && hasPermission(companyId, 'products_edit') && isValidId(productId) &&
          (request.method == 'delete' || (isValidProduct(incoming()) && incoming().id == productId && canCreateProductStock(companyId)));
        // Selling/transferring only ever touches stock/branchStocks — that's a basic right
        // of any cashier ringing up a sale. Changing any other field (price, cost, name,
        // sku, supplier...) is a catalogue edit and needs an explicit permission.
        allow update: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(productId) &&
          isValidProduct(incoming()) && incoming().id == productId && (
            isOwner(companyId)
            || (
              (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'branchStocks'])
                || isRestockCatalogueUpdate(companyId)
                || hasPermission(companyId, 'products_edit'))
              && canUseBranch(companyId, assignedBranch(companyId))
              && (!incoming().diff(existing()).affectedKeys().hasAny(['stock', 'branchStocks']) || canUpdateStock(companyId))
            )
          );
      }

      // Customers subcollection inside Company
      match /customers/{customerId} {
        allow list, get: if isSignedIn() && isMemberOfCompany(companyId);
        allow create, update, delete: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(customerId) &&
          (request.method == 'delete' || (isValidCustomer(incoming()) && incoming().id == customerId));
      }

      // Branches subcollection inside Company
      match /branches/{branchId} {
        allow list, get: if isSignedIn() && isMemberOfCompany(companyId);
        allow create, update: if canWriteCompany(companyId) && isOwner(companyId) && isValidId(branchId)
          && isValidBranch(incoming()) && incoming().id == branchId;
        allow delete: if canWriteCompany(companyId) && isOwner(companyId) && isValidId(branchId);
      }

      // Suppliers subcollection inside Company
      match /suppliers/{supplierId} {
        allow list, get: if isSignedIn() && isMemberOfCompany(companyId);
        allow create, update, delete: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && hasPermission(companyId, 'suppliers_restock') && isValidId(supplierId) &&
          (request.method == 'delete' || (isValidSupplier(incoming()) && incoming().id == supplierId));
      }

      // Sales subcollection inside Company
      match /sales/{saleId} {
        allow get: if isSignedIn() && canUseBranch(companyId, existing().branchId);
        allow list: if isSignedIn() && hasPermission(companyId, 'sales_history') && canUseBranch(companyId, existing().branchId);
        // Any assigned member can ring up a new sale; owner can restore/void records.
        allow create: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(saleId) &&
          isValidSale(incoming()) && incoming().id == saleId &&
          (isValidNewSale(incoming()) || isOwner(companyId)) &&
          canUseBranch(companyId, incoming().branchId) &&
          (!('discount' in incoming()) || incoming().discount == 0 || hasPermission(companyId, 'apply_discount'));
        allow delete: if canWriteCompany(companyId) && isOwner(companyId) && isValidId(saleId);
        // Owner: refunds anywhere and global invoicing. Admin: refunds of its own branch only.
        allow update: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(saleId) && isValidSale(incoming()) && incoming().id == saleId
          && (
            (isOwner(companyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'invoiceStatus']))
            || canAdminRefundSale(companyId)
          );
      }

      // Cash Registers subcollection inside Company
      match /cashRegisters/{registerId} {
        allow list, get: if isSignedIn() && canUseBranch(companyId, registerId);
        allow create: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(registerId)
          && canUseBranch(companyId, registerId) && isValidCashRegisterCreate(companyId, registerId);
        allow update: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(registerId)
          && canUseBranch(companyId, registerId) && isValidCashRegisterUpdate(companyId, registerId)
          && (getAfter(cashLedgerPath(companyId, registerId, incoming().lastTransactionId)).data.type != 'Cierre'
              || hasPermission(companyId, 'cash_close'));
        allow delete: if canWriteCompany(companyId) && isOwner(companyId) && isValidId(registerId);

        // Append-only ledger. A sale entry must be committed with the matching sale document;
        // manual/open/close entries remain branch- and creator-scoped and are immutable.
        match /transactions/{transactionId} {
          allow get: if isSignedIn() && canUseBranch(companyId, registerId);
          allow list: if isSignedIn() && hasPermission(companyId, 'sales_history') && canUseBranch(companyId, registerId);
          allow create: if canWriteCompany(companyId) && isMemberOfCompany(companyId)
            && canUseBranch(companyId, registerId) && isValidId(registerId) && isValidId(transactionId)
            && isValidCashTransaction(incoming(), registerId, transactionId)
            && (incoming().type != 'Cierre' || hasPermission(companyId, 'cash_close'))
            && existsAfter(/databases/$(database)/documents/companies/$(companyId)/cashRegisters/$(registerId))
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/cashRegisters/$(registerId)).data.lastTransactionId == transactionId
            && getAfter(/databases/$(database)/documents/companies/$(companyId)/cashRegisters/$(registerId)).data.currentCash == incoming().balanceAfter
            && (
              incoming().type != 'Venta'
              || (
                incoming().saleId is string
                && existsAfter(/databases/$(database)/documents/companies/$(companyId)/sales/$(incoming().saleId))
                && getAfter(/databases/$(database)/documents/companies/$(companyId)/sales/$(incoming().saleId)).data.branchId == registerId
                && getAfter(/databases/$(database)/documents/companies/$(companyId)/sales/$(incoming().saleId)).data.total == incoming().amount
              )
            );
          allow update, delete: if false;
        }
      }

      // Settings subcollection (branding, config, etc.)
      match /settings/{settingId} {
        // Shared branding/config is needed by POS; only the owner may change it.
        allow read: if isSignedIn() && isMemberOfCompany(companyId);
        allow write: if canWriteCompany(companyId) && isOwner(companyId);
      }

      // Stock movements — append-only audit log of restocks ("surtido") and inter-branch
      // transfers. Creation requires the matching permission and branch pair. Only owner
      // may delete history; updates are denied to everyone.
      match /stockMovements/{movementId} {
        allow get: if isSignedIn() && isMemberOfCompany(companyId) && canReadMovement(companyId, existing());
        allow list: if isSignedIn() && hasPermission(companyId, 'sales_history') && canReadMovement(companyId, existing());
        allow create: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(movementId)
          && isValidStockMovement(incoming()) && incoming().id == movementId
          && (
            ((incoming().type == 'surtido' || incoming().type == 'merma')
              && canUseBranch(companyId, incoming().branchId)
              && (hasPermission(companyId, 'products_edit') || hasPermission(companyId, 'stock_restock')))
            || ((incoming().type == 'transfer_in' || incoming().type == 'transfer_out')
              && canTransferBetween(companyId, incoming().branchId, incoming().counterpartBranchId)
              && hasPermission(companyId, 'stock_transfer'))
          );
        allow update: if false;
        allow delete: if canWriteCompany(companyId) && isOwner(companyId);
      }

      // Checkout funnel audit log — best-effort, invisible record of every sale SAVE ATTEMPT
      // (after all client-side validation/session checks already passed) and its outcome.
      // Exists to answer, after the fact, whether a sale that never reached Firestore was a
      // technical save failure or was never rung up at all — not a general error log, not
      // surfaced in any UI. Fully immutable once written: no update, no delete, not even by
      // owner/admin — its only value is being a record that can't be quietly edited or
      // removed by exactly the people whose accountability it might be used to check.
      match /checkoutEvents/{eventId} {
        allow list, get: if isSignedIn() && hasPermission(companyId, 'sales_history') && canUseBranch(companyId, existing().branchId);
        allow create: if canWriteCompany(companyId) && isMemberOfCompany(companyId) && isValidId(eventId)
          && isValidCheckoutEvent(incoming()) && incoming().id == eventId
          && canUseBranch(companyId, incoming().branchId)
          && (
            incoming().status != 'success'
            || (
              existsAfter(/databases/$(database)/documents/companies/$(companyId)/sales/$(incoming().saleId))
              && getAfter(/databases/$(database)/documents/companies/$(companyId)/sales/$(incoming().saleId)).data.branchId == incoming().branchId
            )
          );
        allow update: if false;
        allow delete: if false;
      }
    }

    // Global Invitation Codes Collection
    match /invitationCodes/{code} {
      allow get: if isSignedIn()
        && resource.data.code == code
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time
        && get(companyPath(resource.data.companyId)).data.invitationCode == code;
      allow list: if false; // Deny standard listing for security
      // Only the Owner of the target company may mint or modify an invite for it — an
      // Non-owner minting one would bypass the members-collection role-grant
      // restriction above (the invite's stored role is trusted as-is on self-join).
      allow create: if isVerifiedUser() && isValidInvitationCode(incoming()) && incoming().code == code
        && isOwner(incoming().companyId);
      allow update: if false;
      allow delete: if isVerifiedUser() && (
        isOwner(resource.data.companyId)
        || (
          resource.data.usageType == 'single'
          && resource.data.expiresAt > request.time
          && existsAfter(memberPath(resource.data.companyId, request.auth.uid))
          && getAfter(memberPath(resource.data.companyId, request.auth.uid)).data.inviteCode == code
          && getAfter(companyPath(resource.data.companyId)).data.invitationCode == null
        )
      );
    }

  }
}
